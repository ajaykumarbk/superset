# ============================================================
#  Superset – Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control!
# ============================================================

# ---------- Server ----------
PORT=3001
NODE_ENV=development

# ---------- Session ----------
# Use a long, random string in production: openssl rand -hex 32
SESSION_SECRET=superset-secret-key-change-me-in-production

# ---------- PostgreSQL ----------
# For local dev with Docker Compose (docker compose up -d):
DB_HOST=localhost
DB_PORT=5432
DB_USER=superset
DB_DATABASE=superset_db
DB_PASSWORD=superset_local_pw

# For production, set these to your real PostgreSQL server credentials.
